	my $duck_ratio = 20;
	my $duck_attack_ms = 20;
	my $duck_release_ms = 500;
	my $duck_lookahead_ms = 500;
	my $filter_complex;
	if ($duck_lookahead_ms > 0) {
		 $filter_complex = 
		 '[0:a]volume=' . $commentary_combine_volume
		. ',asplit=2[commentary][sc];'

		. '[1:a]volume=' . $movie_combine_volume
		. ',adelay=' . $duck_lookahead_ms . ':all=1[delayed_movie];'

		. '[delayed_movie][sc]sidechaincompress='
		.     'threshold=' . $duck_threshold . ':'
		.     'ratio='     . $duck_ratio . ':'
		.     'attack='    . $duck_attack_ms . ':'
		.     'release='   . $duck_release_ms
		. '[delayed_ducked];'

		. '[delayed_ducked]'
		. 'atrim=start=' . ($duck_lookahead_ms / 1000)
		. ',asetpts=PTS-STARTPTS[ducked_movie];'

		. '[ducked_movie][commentary]'
		. 'amix=inputs=2:duration=first:normalize=0[mixed]';
	}
	else {
		 $filter_complex = 
			'[0:a]volume=' . $commentary_combine_volume . ',asplit=2[commentary][sc];' .

			'[1:a]volume=' . $movie_combine_volume . '[movie];' .

			'[movie][sc]sidechaincompress=' .
				'threshold=0.03:' .
				'ratio=20:' .
				'attack=20:' .
				'release=500' .
			'[ducked];' .

			'[ducked][commentary]amix=' .
				'inputs=2:' .
				'normalize=0' .
				'[mixed]';
	}

	$childpid = background(
		{
			stdout => $combined_audio_file,
			description => 'Audio combination',
			stage => 2,
		},
		$AVCONV,
		'-nostdin',
		'-loglevel', 'warning',
		'-hide_banner',

		'-i', $processed_commentary_audio_file,
		'-i', $processed_movie_audio_file,

		'-filter_complex',
		$filter_complex,

		'-map', '[mixed]',
		'-c:a', 'pcm_s32le',
		'-f', 'sox',
		'pipe:1',
	);
}
else {
	# old SOX based autio combination command
	$childpid = background(
		{
			stdout => $combined_audio_file,
			description => 'Audio combination',
			stage => 2,
		},
		$SOX,
		'--volume',  $commentary_combine_volume, $processed_commentary_audio_file,
		'--volume',  $movie_combine_volume,      $processed_movie_audio_file,
		'--combine', 'mix',
		'-t', 'sox', '-'
	);
}

#
# combine processed audio and original video into a new file
#
say "starting movie audio replacement" if $verbose;
my @command = (
	$AVCONV,
	'-loglevel', 'quiet',
	'-threads', '0',
	'-thread_queue_size', '65536',
	'-i', $INPUT_MOVIE_FILE,
	'-thread_queue_size', '262144',
	'-f', 'sox',
	'-i', 'pipe:',

	'-map', '0:v:' . $movie_video_stream,
	'-map', '1:a',
	'-metadata:s:a:0', 'language=eng',
	'-hide_banner',

	'-c:v', 'copy',

	'-c:a', 'aac', '-b:a', $combined_bit_rate . 'k', #'-profile:a', 'aac_main',
	'-strict', '-2',
);
if (defined($metadata)) {
	while (my ($key, $value) = each(%$metadata) ) {	
		if ($key ne 'artwork') {
			if ($key eq 'commentary') {
				push(@command, '-metadata:s:a:0');
				push(@command, 'title=' . $value);
			}
			else {
				push(@command, '-metadata');
				# don't need quotes as the command is not being run through a shell
				push(@command, $key . '=' . $value);
	            if ($key eq 'year') {
	                push(@command, '-metadata');
	                push(@command, 'date=' . $value);
	            }
			}
		}
	}
}
else {
	push(@command, '-map_metadata:g', '0:g');
}

if ($copy_subtitles && $movie_file_has_subtitles) {
	say "copying subtitles streams ", join(', ', @movie_subtitle_streams) if $verbose;
	push(@command, '-c:s');
	push(@command, 'copy');
	foreach my $streamid (@movie_subtitle_streams) {    
		push(@command, '-map');
		push(@command, '0:s:' . $streamid);
	}
}
else {
	push(@command, '-sn');
}
push(@command, '-y');
push(@command, $OUTPUT_MOVIE_FILE);
$childpid = background(
    {
        stdin => $combined_audio_file,
		description => 'Audio replacement in movie file',
		stage => 3,
    },	
	@command,
);
say 'movie audio replacement command: ', join(' ', @command) if $verbose;

if ($very_verbose) {
	say Dumper(\%children);
}

#
# block waiting for children to exit
#
say "waiting for children to finish..." if $verbose;
while ( scalar( keys %children ) ) {
	my $pid = waitpid(-1, 0);

	if ( $pid == -1 ) {
        die "waitpid failed: $!"
            unless $!{ECHILD};
    }

	last if $pid == -1;     # no more children
	my $status = $?;

   	my $description = $children{$pid}{description};
	delete $children{$pid};

	if ( $status == 0 ) {
        say "$description completed successfully" if $verbose;
    }
}

# apply artwork to the output video file
if (defined $artwork_file && length $artwork_file) {
    backticks($ATOMICPARSLEY, $OUTPUT_MOVIE_FILE, '--artwork', 'REMOVE_ALL', '--artwork', $artwork_file, '--overWrite');
}

say 'elapsed time = ', ( time - $starttime ), " seconds";

END {
	cleanup_temp_files();
}
