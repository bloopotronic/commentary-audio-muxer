    return $value;
}

sub parse_volume_adjustment {
    my ($value, $default) = @_;

    $value = $default unless defined $value and length $value;

    return $value / 100.0 if $value =~ /^(\d+(?:\.\d+)?)%$/;
    return $value         if $value =~ /^\d+(?:\.\d+)?$/;

    die "Invalid volume adjustment '$value'";
}

