#region Other resource management
sub cleanup_temp_files {
	while (@tempfiles) {
	    my $filename = $tempfiles[-1];
		say 'removing temp file [', $filename, ']' if $verbose;
		if (-e $filename && !unlink($filename)) {
			warn "cannot remove temp file [$filename]: $!";
		}
		pop(@tempfiles);
	}
	if ($tmpdir && -d $tmpdir && !rmdir($tmpdir)) {
		say 'cannot remove temporary directory [', $tmpdir, ']';
		$tmpdir = undef;
	}
}

sub mymkfifo {
	foreach my $filename (@_) {
		mkfifo( $filename, 0600 ) or die "mkfifo $filename failed: $!";
		push( @tempfiles, $filename );
	}
}
#endregion

#region signal handling
$SIG{INT} = $SIG{TERM} = sub {
	return if $shutting_down;

	$shutting_down = 1;

	say 'interrupted by signal' if $verbose;
	
	my $max_stage = 0;
	for my $entry (values %children) {
        $max_stage = $entry->{stage}
            if $entry->{stage} > $max_stage;
    }

	say 'max stage = ', $max_stage if $very_verbose;
	for(my $stage = 0; $stage <= $max_stage; $stage++) {
		my @remainingPids = wait_for_stage($stage, 'TERM', $child_process_timeout);
		if (scalar @remainingPids) {
			@remainingPids = wait_for_stage($stage, 'KILL', 0);
		}
	}

	exit 2;
};
#endregion

sub getbitrate($filename) {
	my $bit_rate = backticks( $SOX, '--i', '-B', $filename );
	if ($bit_rate =~ /^\s*(\d+(?:\.\d+)?)\s*([kM])\s*$/) {
		$bit_rate = $1;
		if ($2 eq 'M') {
			$bit_rate *= 1000;
		}
	} 
	return $bit_rate;
}

sub check_audio_adjustment($adjustment, $audio_file) {
	my $combine_volume = 0.5;
	if ( defined($adjustment) && $adjustment >= 1 ) {
		$combine_volume *= $adjustment;
		if ( $combine_volume > 1 ) {
			# try to make sure a large adjustment wouldn't be overdoing it
			my $soxstats = backticks( $SOX, $audio_file, '-n', 'stat' );
			if ( $soxstats =~ /^Volume adjustment:\s+(\d?\.\d+)$/m ) {
				my $voladjust = $1;
				if ( $combine_volume > $voladjust ) {
					# use sox's recommendation
					$combine_volume = $voladjust;
				}
			}
		}
	}
	return $combine_volume;
}

