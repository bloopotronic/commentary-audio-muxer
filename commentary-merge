#region Process management
sub waitpid_timeout( $pid, $timeout ) {
	my $alarm_exception = "waitpid timeout\n";
	my $ret             = -1;
	eval {
		local $SIG{ALRM} = sub { die $alarm_exception };
		alarm $timeout;
		$ret = waitpid( $pid, 0 );
		die "waitpid($pid) failed: $!"
            if $ret == -1;
	};
	my $exception = $@;
	alarm 0;
	if ($exception eq $alarm_exception) {
		say "waitpid_timeout: timeout after $timeout seconds"
            if $verbose;

        return -1;
	}
	return $ret;
}

sub wait_for_stage( $stage, $signal, $timeout ) {

	my @target_pids = grep {
        $children{$_}{stage} == $stage
    } keys %children;
	
	if (!@target_pids) {
		return;
	}
	say ("stage $stage: sending ", $signal, " to PIDs: ", join(' ', @target_pids)) if $verbose;
	kill $signal, @target_pids;
	
	my $blocking = $signal eq 'KILL' || !$timeout;
    my $deadline = $blocking ? undef : time() + $timeout;
    my %pending = map { $_ => 1 } @target_pids;

    while (%pending) {
        while (%pending) {
			# reap any child, including ones we're not specifically signalling here
            my $pid = $blocking ? waitpid( -1, 0 ) : waitpid( -1, WNOHANG );

            last if $pid == 0;  # only applies to non-blocking

            if ( $pid == -1 ) {
                die "waitpid failed: $!"
                    unless $!{ECHILD};

				# oops, things have gotten out of sync
				warn "waitpid reported no remaining children; clearing stale PID records"
    	    		if $verbose && (%children || %pending);

				%children = ();
    			return;				
            }

			if ($verbose) {
				my $status = $?;

				if ( WIFEXITED($status) ) {
					$status = WEXITSTATUS($status);
					if ($status == 255) {
						warn "child process $pid exited after shutdown (likely broken pipe)" if $verbose;
    				}
    				else {
						say "child process $pid exited with status $status" if $verbose;
					}					
				}
				elsif ( WIFSIGNALED($status) ) {
					$status = WTERMSIG($status);
					say "child process $pid killed by signal ", $status if $verbose;
				}
				else {
					say "child process ended by some other means: $status" if $verbose;
				}
			}

			# remove child process tracking data
            delete $children{$pid};
            delete $pending{$pid};
        }

		last if $blocking;

		last if time() >= $deadline;

		sleep 0.05;
    }

    return keys %pending;
}

sub secure_exec {
    my $options = ref($_[0]) eq 'HASH' ? shift : {};
	my $cmd     = shift;

	# reset signal handlers
	$SIG{TERM} = $SIG{INT} = 'DEFAULT';

	if (defined $options->{stdin}) {
		open( STDIN, '<', $options->{stdin} ) or die "Could not set stdin to {$options->{stdin}}: $!";
	}
	if (defined $options->{stdout}) {
		open( STDOUT, '>', $options->{stdout} ) or die "Could not redirect stdout to file {$options->{stdout}}: $!";
	}
	if (defined $options->{stderr}) {
		if ($options->{stderr} eq 'stdout') {
			open( STDERR, '>&', \*STDOUT ) or die "Could not set stdin to {$options->{stderr}}: $!";
		}
		else {
			open( STDERR, '>', $options->{stderr} ) or die "Could not redirect stderr to file {$options->{stderr}}: $!";
		}
	}
	my $real_uid = $UID;
	my $real_gid = $GID;

	$EGID = $real_gid;
	$GID  = $real_gid;

	$EUID = $real_uid;
	$UID  = $real_uid;

	die "Can't drop privileges to exec command $cmd->[0]"
    	unless $UID == $EUID && $GID eq $EGID;	

	$ENV{PATH} = "/bin:/usr/bin";    # Minimal PATH.
	# Consider sanitizing the environment even more.

	# suppress color in ffmpeg output
	$ENV{'AV_LOG_FORCE_NOCOLOR'} = 'yes';

	exec { $cmd->[0] } @$cmd or warn "can't exec $$cmd[0]: $!";
	_exit(5);  # don't run an END block, etc
}

sub secure_system {
    my $options = ref($_[0]) eq 'HASH' ? shift : {};
    my @command = @_;
	
	my $pid = fork();
	die "cannot fork to execute command $command[0]: $!" unless defined($pid);
	if ($pid) {
		# parent

		# track child in case of process interruption
		my $full_command = join(' ', @command);
		say 'spawned PID [', $pid, '] ', $full_command if $very_verbose;
		$children{$pid} = {
			command => $full_command,  # for debugging
			stage => $options->{stage} // 0,
			description => $options->{description} // '',
		};

		my $ret;

		# wait for process to finish
		# TODO apply timeout for warning
		while (1) {
            $ret = waitpid($pid, 0);

            last if $ret == $pid;
            next if $ret == -1 && $!{EINTR};

            delete $children{$pid};

            die "waitpid failed for PID $pid: $!"
                unless $ret == -1 && $!{ECHILD};

            return;
        }

		my $status = $?;
        delete $children{$pid};

        return $status;
	}
	else {
		secure_exec( $options, \@command );
	}	
}

sub backticks {
	local (*KID);

	my $pid = open( KID, "-|" );
	die "Can't fork to execute command $_[0]: $!" unless defined( $pid );
	if ($pid) { 
		# parent
		my @chunks = <KID>;
		close KID;
		my $exitstatus = 0;
		if ($?) {
			if ( WIFEXITED($?) ) {
				$exitstatus = WEXITSTATUS($?);
				say "exit status = $exitstatus" if $verbose;
			}
			elsif ( WIFSIGNALED($?) ) {
				$exitstatus = WTERMSIG($?);
				say "exitted with signal status = $exitstatus" if $verbose;
			}
			else {
				say "exit status = $?" if $verbose;
			}
		}

		my $ret   = '';
		my $count = scalar(@chunks);
		if ( $count > 0 ) {
			chomp $chunks[ $count - 1 ];    # remove final newline if present
			$ret = join( '', @chunks );
		}
		$? = $exitstatus;
		return $ret;
	}
	else {
		secure_exec({ stdin => '/dev/null' }, \@_);
	}
}

sub background {
    my $options = ref($_[0]) eq 'HASH' ? shift : {};
    my @command = @_;

	my $pid = fork();
	die "cannot fork to execute command $command[0]: $!" unless defined($pid);
	if ($pid) {
		my $full_command = join(' ', @command);
		say 'spawned PID [', $pid, '] ', $full_command if $very_verbose;
		$children{$pid} = {
			command => $full_command,  # for debugging
			stage => $options->{stage} // 0,
			description => $options->{description} // '',
		};

		# parent
		return $pid;
	}
	else {
		secure_exec( $options, \@command );
	}
}
